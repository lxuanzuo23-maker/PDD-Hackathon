# SQLite file, ephemeral on Render — resets on redeploy (see DISCLOSURES.md)
DATABASE_URL="file:./dev.db"

# Which provider llm.ts uses: minimax | tokenrouter | openai | anthropic.
# Verify MiniMax works in the first 30 minutes; switch if not working by T+0:30.
LLM_PROVIDER="minimax"

# Person B pivot UI: fixtures are explicit and visibly labeled. Set to "live"
# only after the onboarding, goals, growth, and feedback APIs are deployed.
NEXT_PUBLIC_UI_DATA_MODE="fixture"

# TokenRouter (sponsor track): OpenAI-compatible API at api.tokenrouter.com.
# Set LLM_PROVIDER="tokenrouter" to route through it. Keys must stay out of git.
TOKENROUTER_API_KEY=""
TOKENROUTER_MODEL="google/gemini-3.5-flash-lite"

# Band Goal Room (Remote Agent credentials; never commit real values)
BAND_COACH_AGENT_ID=""
BAND_COACH_API_KEY=""
BAND_COACH_HANDLE="@goal-coach"
BAND_REFLECTION_AGENT_ID=""
BAND_REFLECTION_API_KEY=""
BAND_REFLECTION_HANDLE="@reflection-guide"
INTERNAL_WEBHOOK_SECRET=""
TINY_WINS_WEB_URL="http://localhost:3000"

MINIMAX_API_KEY=""
MINIMAX_GROUP_ID=""
MINIMAX_MODEL="MiniMax-Text-01"
# Used by scripts/verify-minimax.mjs; default is usually right.
MINIMAX_BASE_URL="https://api.minimax.io/v1"

# Stretch (P2) only:
ELEVENLABS_API_KEY=""

# Fallback providers (only need ONE of these set)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
