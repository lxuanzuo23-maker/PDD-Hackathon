# SQLite file, ephemeral on Render — resets on redeploy (see DISCLOSURES.md)
DATABASE_URL="file:./dev.db"

# Which provider llm.ts uses: minimax | tokenrouter | openai | anthropic.
# Verify MiniMax works in the first 30 minutes; switch if not working by T+0:30.
LLM_PROVIDER="minimax"

# TokenRouter (sponsor track): OpenAI-compatible routing gateway.
# Set LLM_PROVIDER="tokenrouter" to route through it. Keys start with tr_.
TOKENROUTER_API_KEY=""
TOKENROUTER_MODEL="auto:balance"

MINIMAX_API_KEY=""
MINIMAX_GROUP_ID=""
MINIMAX_MODEL="MiniMax-Text-01"
# Used by scripts/verify-minimax.mjs; default is usually right.
MINIMAX_BASE_URL="https://api.minimax.io/v1"

# ElevenLabs voice pep talk (sponsor track, P2). Voice-off is a labeled
# fallback — the app runs fully without these.
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
ELEVENLABS_MODEL_ID=""

# Fallback providers (only need ONE of these set)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
