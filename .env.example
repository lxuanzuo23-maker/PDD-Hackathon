# SQLite file, ephemeral on Render — resets on redeploy (see DISCLOSURES.md)
DATABASE_URL="file:./dev.db"

# Which provider llm.ts uses: minimax | tokenrouter | openai | anthropic.
# Verify MiniMax works in the first 30 minutes; switch if not working by T+0:30.
LLM_PROVIDER="minimax"

# TokenRouter (sponsor track): Responses API routing gateway.
# Set LLM_PROVIDER="tokenrouter" to route through it. Keys must stay out of git.
TOKENROUTER_API_KEY=""
TOKENROUTER_MODEL="auto:balance"

MINIMAX_API_KEY=""
MINIMAX_GROUP_ID=""
MINIMAX_MODEL="MiniMax-Text-01"
# Used by scripts/verify-minimax.mjs; default is usually right.
MINIMAX_BASE_URL="https://api.minimax.io/v1"

# Stretch (P2) only:
ELEVENLABS_API_KEY=""

# Fallback providers (only need ONE of these set)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
