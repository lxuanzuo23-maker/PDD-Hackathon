// Prisma schema for TinyWins.
// SQLite + ephemeral disk on Render: data resets on redeploy. This is a
// known, disclosed limitation (see DISCLOSURES.md) — acceptable for a demo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  streak       Int       @default(0)
  // Set to the UTC date of the last streak-extending check-in. Required
  // because the seeded/historical ledger can't otherwise identify "today's
  // first completion" — see contract.ts STREAK_BONUS.
  lastStreakAt DateTime?
  createdAt    DateTime  @default(now())

  goals        Goal[]
  ledger       PointsLedger[]
  redemptions  Redemption[]
  companion    CompanionState?
  traits       UserTraits?
  moodCheckIns MoodCheckIn[]
}

// Open-ended goal (lose weight, buy a car, build a project, start a
// startup — user's own words), replacing the old flat one-off Task.
// Runs from startDate to endDate with recurring check-ins.
model Goal {
  id               String    @id @default(cuid())
  userId           String
  title            String
  category         String // free text, user-defined — not an enum
  difficulty       Int // 1 | 2 | 3, still drives base points
  status           String    @default("active") // active | completed | abandoned
  startDate        DateTime  @default(now())
  endDate          DateTime
  checkInFrequency String    @default("daily") // daily | weekly
  // Points deducted per missed check-in period; configurable per goal
  // since stakes vary ("fifty points or twenty points or whatever").
  penaltyPoints    Int       @default(20)
  bandRoomId       String?   @unique
  // Drives both streak continuation and the lazy missed-day penalty check.
  lastCheckInAt    DateTime?
  createdAt        DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id])
  checkIns CheckIn[]
  roomEvents GoalRoomEvent[]
  reflections Reflection[]
  coachSessions CoachSession[]

  @@index([userId])
}

// One row per completed check-in: the coach's two questions, the
// honesty-check "how did it feel" answer, and the verifier's
// plausibility/effort judgment for that completion.
model CheckIn {
  id         String   @id @default(cuid())
  goalId     String
  answers    String // JSON-encoded string[] of the user's two answers
  feeling    String // free-text answer to "how did completing this feel"
  verdict    String // accepted | partial | rejected
  verdictMessage String @default("") // verifier's user-facing explanation
  multiplier Float // 0.5x - 2.0x, effort-based
  createdAt  DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id])
  reflection Reflection?

  @@index([goalId])
}

model GoalRoomEvent {
  id String @id @default(cuid())
  goalId String
  userId String
  type String
  payload String
  idempotencyKey String? @unique
  occurredAt DateTime
  createdAt DateTime @default(now())
  goal Goal @relation(fields: [goalId], references: [id])
  @@index([goalId, occurredAt])
}

model Reflection {
  id String @id @default(cuid())
  goalId String
  checkInId String? @unique
  kind String
  summary String
  insights String
  nextFocus String?
  createdAt DateTime @default(now())
  goal Goal @relation(fields: [goalId], references: [id])
  checkIn CheckIn? @relation(fields: [checkInId], references: [id])
  @@index([goalId, kind])
}

model CoachSession {
  id String @id @default(cuid())
  goalId String?
  sessionId String @unique
  approach String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  goal Goal? @relation(fields: [goalId], references: [id])
}

// Onboarding quiz answers + the adaptive profile the coach reads from.
model UserTraits {
  id                  String   @id @default(cuid())
  userId              String   @unique
  age                 Int
  gender              String
  habitToImprove      String?
  newHabitGoal        String?
  // Ephemeral disk on Render, same disclosure as the rest of the DB.
  visionBoardImageUrl String?
  visionBoardThemes   String? // JSON-encoded string[]
  communicationStyle  String   @default("encouraging")
  motivationStyle     String   @default("support")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// Recurring "how are you feeling today" check-in — separate from the
// per-goal CheckIn.feeling honesty question. Feeds the growth dashboard.
model MoodCheckIn {
  id        String   @id @default(cuid())
  userId    String
  mood      String // rough | low | okay | good | great
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// Append-only ledger. Balance is always derived by summing amount, never
// stored directly — this is what makes the daily anti-gaming cap auditable.
model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String // e.g. "goal-checkin", "redemption", "streak-bonus", "penalty"
  goalId    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model RewardItem {
  id          String @id @default(cuid())
  name        String
  description String
  cost        Int
  kind        String // "theme" | "accessory" | "skip-token"
  // Rendered as the sticker in the collection and, for accessories, worn on
  // the companion — spending points has to visibly change something.
  emoji       String @default("⭐")
  // Only set for kind == "theme": which backdrop the theme activates.
  themeKey    String? // "meadow" | "dusk" | "sunrise"

  redemptions Redemption[]
}

model Redemption {
  id           String   @id @default(cuid())
  userId       String
  rewardItemId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  rewardItem RewardItem @relation(fields: [rewardItemId], references: [id])

  @@index([userId])
}

model CompanionState {
  id     String @id @default(cuid())
  userId String @unique
  level  Int    @default(1)
  xp     Int    @default(0)
  mood   String @default("content") // content | proud | sleepy | worried

  user User @relation(fields: [userId], references: [id])
}
